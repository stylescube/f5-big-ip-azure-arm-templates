{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vmName": {
      "type": "string",
      "defaultValue": "bigip-vm",
      "metadata": {
        "description": "Name of the F5 BIG-IP Virtual Machine."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser",
      "metadata": {
        "description": "Administrator username for the BIG-IP VM."
      }
    },
    "authenticationType": {
      "type": "string",
      "defaultValue": "password",
      "allowedValues": [
        "sshPublicKey",
        "password"
      ],
      "metadata": {
        "description": "Type of authentication to use on the Virtual Machine."
      }
    },
    "adminPasswordOrKey": {
      "type": "securestring",
      "metadata": {
        "description": "SSH Key or password for the Virtual Machine."
      }
    },
    "vmSize": {
      "type": "string",
      "defaultValue": "Standard_DS3_v2",
      "metadata": {
        "description": "Size of the BIG-IP Virtual Machine (must support at least 2 NICs)."
      }
    },
    "imageOffer": {
      "type": "string",
      "defaultValue": "f5-big-ip-byol",
      "allowedValues": [
        "f5-big-ip-byol",
        "f5-big-ip-best",
        "f5-big-ip-good",
        "f5-big-ip-better"
      ],
      "metadata": {
        "description": "F5 BIG-IP Marketplace Offer."
      }
    },
    "imageSku": {
      "type": "string",
      "defaultValue": "f5-big-all-2slot-byol",
      "metadata": {
        "description": "F5 BIG-IP Marketplace SKU (e.g., f5-big-all-2slot-byol for BYOL, or f5-big-best-plus-hourly-25mbps for PAYG)."
      }
    },
    "bigipVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "F5 BIG-IP version (e.g., latest or 17.1.100000)."
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "bigip-vnet",
      "metadata": {
        "description": "Name of the Virtual Network."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Address prefix for the Virtual Network."
      }
    },
    "mgmtSubnetName": {
      "type": "string",
      "defaultValue": "mgmt-subnet",
      "metadata": {
        "description": "Name of the Management subnet attached to eth0."
      }
    },
    "mgmtSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/24",
      "metadata": {
        "description": "Address prefix for the Management subnet (eth0)."
      }
    },
    "externalSubnetName": {
      "type": "string",
      "defaultValue": "external-subnet",
      "metadata": {
        "description": "Name of the Public/External traffic subnet attached to eth1."
      }
    },
    "externalSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.1.0/24",
      "metadata": {
        "description": "Address prefix for the Public/External traffic subnet (eth1)."
      }
    },
    "restrictedSrcAddress": {
      "type": "string",
      "defaultValue": "*",
      "metadata": {
        "description": "Source IP/CIDR allowed to access Management ports on eth0 (SSH 22 and GUI 443). Specify your IP CIDR for production."
      }
    }
  },
  "variables": {
    "mgmtNsgName": "[format('{0}-eth0-mgmt-nsg', parameters('vmName'))]",
    "extNsgName": "[format('{0}-eth1-ext-nsg', parameters('vmName'))]",
    "mgmtPublicIpName": "[format('{0}-eth0-mgmt-pip', parameters('vmName'))]",
    "extPublicIpName": "[format('{0}-eth1-ext-pip', parameters('vmName'))]",
    "mgmtNicName": "[format('{0}-eth0-mgmt-nic', parameters('vmName'))]",
    "extNicName": "[format('{0}-eth1-ext-nic', parameters('vmName'))]",
    "mgmtDnsLabelPrefix": "[toLower(format('{0}-mgmt-{1}', parameters('vmName'), uniqueString(resourceGroup().id)))]",
    "extDnsLabelPrefix": "[toLower(format('{0}-ext-{1}', parameters('vmName'), uniqueString(resourceGroup().id)))]",
    "linuxConfiguration": {
      "disablePasswordAuthentication": true,
      "ssh": {
        "publicKeys": [
          {
            "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]",
            "keyData": "[parameters('adminPasswordOrKey')]"
          }
        ]
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-05-01",
      "name": "[variables('mgmtNsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Mgmt-SSH",
            "properties": {
              "description": "Allow SSH access to BIG-IP management interface (eth0)",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "[parameters('restrictedSrcAddress')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 100,
              "direction": "Inbound"
            }
          },
          {
            "name": "Allow-Mgmt-GUI-HTTPS",
            "properties": {
              "description": "Allow BIG-IP TMUI Management HTTPS on 443 (eth0 default on multi-NIC)",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "[parameters('restrictedSrcAddress')]",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 110,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-05-01",
      "name": "[variables('extNsgName')]",
      "location": "[parameters('location')]",
      "properties": {
        "securityRules": [
          {
            "name": "Allow-Public-HTTPS-VIP",
            "properties": {
              "description": "Allow public HTTPS application traffic on eth1",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "443",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 100,
              "direction": "Inbound"
            }
          },
          {
            "name": "Allow-Public-HTTP-VIP",
            "properties": {
              "description": "Allow public HTTP application traffic on eth1",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "80",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 110,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-05-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('mgmtNsgName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('extNsgName'))]"
      ],
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "[parameters('mgmtSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('mgmtSubnetPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('mgmtNsgName'))]"
              }
            }
          },
          {
            "name": "[parameters('externalSubnetName')]",
            "properties": {
              "addressPrefix": "[parameters('externalSubnetPrefix')]",
              "networkSecurityGroup": {
                "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('extNsgName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "[variables('mgmtPublicIpName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('mgmtDnsLabelPrefix')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-05-01",
      "name": "[variables('extPublicIpName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "dnsSettings": {
          "domainNameLabel": "[variables('extDnsLabelPrefix')]"
        }
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-05-01",
      "name": "[variables('mgmtNicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('mgmtPublicIpName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('mgmtNsgName'))]"
      ],
      "properties": {
        "enableIPForwarding": false,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('mgmtNsgName'))]"
        },
        "ipConfigurations": [
          {
            "name": "mgmt-ipconfig",
            "properties": {
              "primary": true,
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('mgmtPublicIpName'))]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('mgmtSubnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-05-01",
      "name": "[variables('extNicName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]",
        "[resourceId('Microsoft.Network/publicIPAddresses', variables('extPublicIpName'))]",
        "[resourceId('Microsoft.Network/networkSecurityGroups', variables('extNsgName'))]"
      ],
      "properties": {
        "enableIPForwarding": true,
        "networkSecurityGroup": {
          "id": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('extNsgName'))]"
        },
        "ipConfigurations": [
          {
            "name": "ext-ipconfig",
            "properties": {
              "primary": true,
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": {
                "id": "[resourceId('Microsoft.Network/publicIPAddresses', variables('extPublicIpName'))]"
              },
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), parameters('externalSubnetName'))]"
              }
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-07-01",
      "name": "[parameters('vmName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('mgmtNicName'))]",
        "[resourceId('Microsoft.Network/networkInterfaces', variables('extNicName'))]"
      ],
      "plan": {
        "name": "[parameters('imageSku')]",
        "publisher": "f5-networks",
        "product": "[parameters('imageOffer')]"
      },
      "properties": {
        "hardwareProfile": {
          "vmSize": "[parameters('vmSize')]"
        },
        "osProfile": {
          "computerName": "[parameters('vmName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "adminPassword": "[parameters('adminPasswordOrKey')]",
          "linuxConfiguration": "[if(equals(parameters('authenticationType'), 'password'), null(), variables('linuxConfiguration'))]"
        },
        "storageProfile": {
          "imageReference": {
            "publisher": "f5-networks",
            "offer": "[parameters('imageOffer')]",
            "sku": "[parameters('imageSku')]",
            "version": "[parameters('bigipVersion')]"
          },
          "osDisk": {
            "createOption": "FromImage",
            "managedDisk": {
              "storageAccountType": "Premium_LRS"
            }
          }
        },
        "networkProfile": {
          "networkInterfaces": [
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('mgmtNicName'))]",
              "properties": {
                "primary": true
              }
            },
            {
              "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('extNicName'))]",
              "properties": {
                "primary": false
              }
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "eth0MgmtPublicIP": {
      "type": "string",
      "value": "[reference(variables('mgmtPublicIpName')).ipAddress]"
    },
    "eth0MgmtFqdn": {
      "type": "string",
      "value": "[reference(variables('mgmtPublicIpName')).dnsSettings.fqdn]"
    },
    "managementGuiUrl": {
      "type": "string",
      "value": "[format('https://{0}', reference(variables('mgmtPublicIpName')).dnsSettings.fqdn)]"
    },
    "sshCommand": {
      "type": "string",
      "value": "[format('ssh {0}@{1}', parameters('adminUsername'), reference(variables('mgmtPublicIpName')).dnsSettings.fqdn)]"
    },
    "eth1PublicTrafficVIP": {
      "type": "string",
      "value": "[reference(variables('extPublicIpName')).ipAddress]"
    },
    "eth1PublicTrafficFqdn": {
      "type": "string",
      "value": "[reference(variables('extPublicIpName')).dnsSettings.fqdn]"
    }
  }
}
